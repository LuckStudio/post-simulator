{
  "name": "post-simulator",
  "version": "0.3.0",
  "private": true,
  "description": "Post Simulator: simula cómo se verá una publicación (texto, imágenes, vídeo, documentos y carruseles) antes de subirla.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/publish-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:legacy": "node scripts/compare-legacy.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
